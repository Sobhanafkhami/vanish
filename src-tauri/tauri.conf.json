{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vanish",
  "version": "0.1.0",
  "identifier": "app.vanish.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Vanish",
        "width": 980,
        "height": 720,
        "minWidth": 820,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "theme": "Dark",
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/*": "binaries/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCQTEyQjFDRTU5OTBFMTUKUldRVkRwbmxIQ3VobStndFZPWW9aTXBIR2VBeFpWRTRrLzJNT1BoWHlkbm9pOWZnQ3JuM3ZvUXYK",
      "endpoints": [
        "https://github.com/Sobhanafkhami/vanish/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
